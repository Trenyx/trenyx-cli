{
  "name": "trenyx",
  "version": "0.1.2",
  "description": "Plant realistic bugs in a throwaway copy of your repo and see which ones your tests catch. Runs on your machine, on your own AI key.",
  "license": "SEE LICENSE IN LICENSE AND catalogue/LICENSE",
  "type": "module",
  "bin": {
    "trenyx": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "catalogue",
    "LICENSE",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test --test-concurrency=4 'dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  },
  "peerDependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.0",
    "@anthropic-ai/vertex-sdk": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/bedrock-sdk": {
      "optional": true
    },
    "@anthropic-ai/vertex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.0",
    "@anthropic-ai/vertex-sdk": "1.1.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.1"
  }
}
